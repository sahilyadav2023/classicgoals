# ─────────────────────────────────────────────
# CLASSIC GOALS — Environment Variables
# Copy this file to .env.local and fill in values
# ─────────────────────────────────────────────

# Resend API key for contact form emails
# Get yours at https://resend.com
RESEND_API_KEY=re_your_key_here

# Email address to receive contact form submissions
CONTACT_TO_EMAIL=theclassicgoals00@gmail.com

# Public URL (no trailing slash) — used for sitemap and OG metadata
NEXT_PUBLIC_SITE_URL=https://classicgoals.in
